# Copy to .env.local for local testing. On Vercel, add these under
# Project -> Settings -> Environment Variables (never commit real values).

# The Gmail account that sends the contact-form notifications, and a Google
# App Password for it (16 characters, generated at
# https://myaccount.google.com/apppasswords — NOT the account's real password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: send the notifications to a different address than GMAIL_USER.
CONTACT_TO_EMAIL=

# Optional: the site's public address for SEO links (sitemap, social cards).
# On Vercel it falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=
