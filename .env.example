# Copy to .env.local for local testing. On Vercel, add these under
# Project -> Settings -> Environment Variables (never commit real values).

# GoHighLevel workflow "Inbound Webhook" trigger URL. Server-only: the contact
# form posts to /api/contact/, which forwards to this address.
CONTACT_WEBHOOK_URL=

# Optional: the site's public address for SEO links (sitemap, social cards).
# On Vercel it falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=
